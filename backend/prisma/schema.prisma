// Proposed onboarding model; no migration has been applied.
// Prisma 7.10.1 target: connection configuration belongs in prisma.config.ts.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum HousingIntent {
  HAVE_ROOM
  TEAM_UP
  NEED_ROOM
}

enum Occupation {
  STUDENT
  WORKING_PROFESSIONAL
  SELF_EMPLOYED
  OTHER
}

enum SleepSchedule {
  EARLY_BIRD
  NIGHT_OWL
  FLEXIBLE
}

enum Cleanliness {
  RELAXED
  REGULAR
  VERY_TIDY
}

enum FoodHabit {
  VEGAN
  VEGETARIAN
  EGGETARIAN
  NON_VEGETARIAN
}

enum SmokingHabit {
  NON_SMOKER
  OUTDOORS_ONLY
  INDOORS
}

enum GuestFrequency {
  RARELY
  OCCASIONALLY
  FREQUENTLY
}

enum Gender {
  WOMAN
  MAN
  NON_BINARY
  PREFER_NOT_TO_SAY
}

enum WorkStudySchedule {
  DAYTIME
  EVENING
  NIGHT
  ROTATING
  FLEXIBLE
}

enum PetPreference {
  OK_WITH_PETS
  NO_PETS
  NO_PREFERENCE
}

model User {
  id                    String               @id @default(uuid()) @db.Uuid
  clerkUserId           String               @unique
  housingIntent         HousingIntent?
  onboardingRevision    Int                  @default(0)
  onboardingCompletedAt DateTime?            @db.Timestamptz(3)
  discoveryEnabled      Boolean              @default(false)
  matchingEnabledAt     DateTime?            @db.Timestamptz(3)
  suspendedAt           DateTime?            @db.Timestamptz(3)
  createdAt             DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime             @updatedAt @db.Timestamptz(3)
  profile               Profile?
  housingPreference     HousingPreference?
  lifestylePreference   LifestylePreference?
  flatListing           FlatListing?
  actionsMade           DiscoveryAction[]    @relation("ActionActor")
  actionsReceived       DiscoveryAction[]    @relation("ActionTarget")
  matchesAsLow          Match[]              @relation("MatchLow")
  matchesAsHigh         Match[]              @relation("MatchHigh")
  blocksMade            UserBlock[]          @relation("Blocker")
  blocksReceived        UserBlock[]          @relation("Blocked")
  reportsMade           UserReport[]         @relation("Reporter")
  reportsReceived       UserReport[]         @relation("ReportTarget")

  @@map("users")
}

model Profile {
  userId      String      @id @db.Uuid
  publicId    String      @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  version     Int         @default(0)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String?     @db.VarChar(80)
  birthDate   DateTime?   @db.Date
  gender      Gender?
  occupation  Occupation?
  bio         String?     @db.VarChar(500)
  avatarUrl   String?
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @db.Timestamptz(3)

  @@map("profiles")
}

model HousingPreference {
  userId              String    @id @db.Uuid
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  city                String?   @db.VarChar(100)
  preferredLocations  String[]  @default([])
  locationsFlexible   Boolean?
  monthlyRentMinPaise Int?
  monthlyRentMaxPaise Int?
  moveInDate          DateTime? @db.Date
  moveInLatestDate    DateTime? @db.Date
  moveInFlexible      Boolean?
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(3)

  @@map("housing_preferences")
}

model LifestylePreference {
  userId                     String              @id @db.Uuid
  user                       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  sleepSchedule              SleepSchedule?
  cleanliness                Cleanliness?
  foodHabit                  FoodHabit?
  smokingHabit               SmokingHabit?
  bringingPet                Boolean?
  guestFrequency             GuestFrequency?
  acceptedSleepSchedules     SleepSchedule[]     @default([])
  acceptedCleanlinessLevels  Cleanliness[]       @default([])
  acceptedFoodHabits         FoodHabit[]         @default([])
  acceptedSmokingHabits      SmokingHabit[]      @default([])
  flatmatePetPreference      PetPreference?
  acceptedGuestFrequencies   GuestFrequency[]    @default([])
  acceptedGenders            Gender[]            @default([])
  workStudySchedule          WorkStudySchedule?
  acceptedWorkStudySchedules WorkStudySchedule[] @default([])
  createdAt                  DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime            @updatedAt @db.Timestamptz(3)

  @@map("lifestyle_preferences")
}

enum ListingStatus {
  DRAFT
  PUBLISHED
  PAUSED
  CLOSED
}

enum RoomType {
  PRIVATE
  SHARED
}

enum Furnishing {
  UNFURNISHED
  SEMI_FURNISHED
  FURNISHED
}

enum PhotoState {
  PENDING
  PROCESSING
  READY
  FAILED
  DELETE_PENDING
}

enum PhotoCategory {
  ROOM
  SHARED_SPACE
  OTHER
}

// One reusable listing per owner (unique ownerId). Restrict: account deletion must run photo cleanup first.
model FlatListing {
  id                    String        @id @default(uuid()) @db.Uuid
  ownerId               String        @unique @db.Uuid
  owner                 User          @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  status                ListingStatus @default(DRAFT)
  version               Int           @default(0)
  title                 String?       @db.VarChar(100)
  description           String?       @db.VarChar(2000)
  cityId                String?
  localityId            String?
  bedrooms              Int?
  availablePlaces       Int?
  roomType              RoomType?
  furnishing            Furnishing?
  monthlyRentPaise      Int?
  depositPaise          Int?
  chargesNote           String?       @db.VarChar(500)
  availableFrom         DateTime?     @db.Date
  availableFlexible     Boolean?
  permissionConfirmedAt DateTime?     @db.Timestamptz(3)
  publishedAt           DateTime?     @db.Timestamptz(3)
  coverPhotoId          String?       @unique @db.Uuid
  coverPhoto            FlatPhoto?    @relation("ListingCover", fields: [coverPhotoId], references: [id], onDelete: SetNull)
  photos                FlatPhoto[]   @relation("ListingPhotos")
  createdAt             DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime      @updatedAt @db.Timestamptz(3)

  @@index([status, cityId, localityId])
  @@map("flat_listings")
}

// Object keys only (never URLs). Original filenames are display-only.
model FlatPhoto {
  id                   String        @id @default(uuid()) @db.Uuid
  listingId            String        @db.Uuid
  listing              FlatListing   @relation("ListingPhotos", fields: [listingId], references: [id], onDelete: Restrict)
  coverOf              FlatListing?  @relation("ListingCover")
  stagingKey           String        @unique
  finalKey             String?       @unique
  state                PhotoState    @default(PENDING)
  category             PhotoCategory
  sortOrder            Int           @default(0)
  mimeType             String?
  bytes                Int?
  width                Int?
  height               Int?
  contentHash          String?
  originalName         String?       @db.VarChar(200)
  uploadExpiresAt      DateTime      @db.Timestamptz(3)
  processingLeaseUntil DateTime?     @db.Timestamptz(3)
  createdAt            DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime      @updatedAt @db.Timestamptz(3)

  @@unique([listingId, contentHash])
  @@index([listingId, state])
  @@map("flat_photos")
}

enum DecisionKind {
  LIKE
  PASS
}

enum ReportReason {
  HARASSMENT
  SCAM
  FAKE_PROFILE
  INAPPROPRIATE_CONTENT
  OTHER
}

enum ReportStatus {
  OPEN
  IN_REVIEW
  ACTIONED
  DISMISSED
}

// Private directed decision. Block/unmatch set invalidatedAt so an old Like never counts as consent again.
model DiscoveryAction {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId       String       @db.Uuid
  actor         User         @relation("ActionActor", fields: [actorId], references: [id], onDelete: Cascade)
  targetId      String       @db.Uuid
  target        User         @relation("ActionTarget", fields: [targetId], references: [id], onDelete: Cascade)
  kind          DecisionKind
  invalidatedAt DateTime?    @db.Timestamptz(3)
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)

  @@unique([actorId, targetId])
  @@index([targetId])
  @@map("discovery_actions")
}

// Canonical unordered pair: userLowId < userHighId (CHECK). One row per pair ever; ended pairs never rematch in P0.
model Match {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userLowId    String       @db.Uuid
  userLow      User         @relation("MatchLow", fields: [userLowId], references: [id], onDelete: Cascade)
  userHighId   String       @db.Uuid
  userHigh     User         @relation("MatchHigh", fields: [userHighId], references: [id], onDelete: Cascade)
  scoreAtMatch Int
  scorePolicy  String       @db.VarChar(40)
  endedAt      DateTime?    @db.Timestamptz(3)
  endedById    String?      @db.Uuid
  endReason    String?      @db.VarChar(20)
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  reports      UserReport[]

  @@unique([userLowId, userHighId])
  @@index([userHighId])
  @@map("matches")
}

// Revocation keeps history: an old block still keeps the pair out of discovery.
model UserBlock {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  blockerId String    @db.Uuid
  blocker   User      @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String    @db.Uuid
  blocked   User      @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("user_blocks")
}

// Intake only. Reviewed by an operator (see docs/report-review.md); never auto-actioned or shown to the target.
model UserReport {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reporterId String       @db.Uuid
  reporter   User         @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetId   String       @db.Uuid
  target     User         @relation("ReportTarget", fields: [targetId], references: [id], onDelete: Cascade)
  reason     ReportReason
  details    String?      @db.VarChar(1000)
  matchId    String?      @db.Uuid
  match      Match?       @relation(fields: [matchId], references: [id], onDelete: SetNull)
  listingId  String?      @db.Uuid
  snapshot   Json?
  status     ReportStatus @default(OPEN)
  reviewedAt DateTime?    @db.Timestamptz(3)
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)

  @@index([status, createdAt])
  @@index([targetId])
  @@map("user_reports")
}
