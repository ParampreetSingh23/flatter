CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
FRONTEND_ORIGIN=http://localhost:3000
PORT=4000
DATABASE_URL=postgresql://...-pooler.../neondb   # runtime (pooled)
DIRECT_URL=postgresql://.../neondb               # prisma migrate (direct)
# Flat photos: private Cloudflare R2 bucket (see docs/r2-setup.md). Without these, photo upload/publish are disabled.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Messaging (Socket.IO on this same server). Run ONE instance; see docs/deployment.md.
# Clerk -> Webhooks -> endpoint https://<api-host>/api/webhooks/clerk, event "user.deleted".
# Keep the signing secret in the deployment secret store, never in a committed file. Unset = account deletion is not wired (route answers 503).
CLERK_WEBHOOK_SIGNING_SECRET=
